---
import { withBase } from "../utils/url";
import {social_links} from "../utils/socials"

const navItemClass =
  "text-2xl hover:text-primary underline underline-offset-4 decoration-transparent hover:decoration-primary transition-colors duration-200";

  
const sections = [
  {
    label: "About Us",
    items: [
      { title: "Who are we?", href: "/about-us#WhoAreWe", desc: "What is Herndon Robotics and what do we stand for?" },
      { title: "Portfolio", href: "/about-us#portfolio", desc: "What we've done over the years." },
      { title: "Team Members", href: "/about-us#team-members", desc: "Mentors + Students" },
      { title: "Sponsors", href: "/about-us#sponsors", desc: "Who supports us?" },
    ],
  },
  {
    label: "Getting Involved",
    items: [
      { title: "Joining The Club", href: "/getting-involved#new-member", desc: "For any HHS students looking to join the Herndon Robotics Club and grow their STEM expertise." },
      { title: "Mentorship", href: "/getting-involved#new-mentors", desc: "Become a mentor for Herndon Robotics and help guide the next generation." },
      { title: "Plan Outreach", href: "/getting-involved#plan-outreach", desc: "Do you want us to show off our robots at one of your events?" },
      { title: "Sponsor Us", href: "/getting-involved#new-sponsor", desc: "Support our team through monetary or other means." },
    ],
  },
  {
    label: "Current Members",
    items: [
      { title: "Meetings/Events", href: "/current-member#calendar", desc: "What events do we have coming up? When are meetings? Do we have a meeting today?" },
      { title: "Forms", href: "/current-member#forms", desc: "Forms for field trips, emergency care, and instructions on how to join our FIRST team." },
      { title: "Training Materials", href: "/current-member#resources", desc: "Want to grow your skills? look here." },
    ],
  },
];


---

<div
  class="px-4 py-2 bg-muted border border-border flex flex-row flex-wrap justify-center md:justify-between max-w-full w-full font-audiowide"
  x-data="{ mobileOpen: false }"
>
  <!-- Team Logo & Name -->
  <div class="flex flex-row gap-4 w-min items-center">
    <h1 class="text-5xl content-center font-bold w-max tracking-tighter text-center">Epsilon<br>Delta</h1>
    
    <img src={withBase("logo.png")} class="h-24 w-auto object-contain">
    

    <div class="grid-cols-2 h-full grid-rows-3 aspect-2/3 gap-1 grid" id="socials">
      {social_links.map((social) => (
        <a 
          href={social.link}
          class="flex items-center justify-center bg-foreground m-0.5 aspect-square"
          style={
            `mask-image: url('${social.social}');
            mask-size: contain;
            mask-repeat: no-repeat;
            mask-position: center;`
          }></a>
      ))}
    </div> 
  </div>

  

  <!-- Desktop Navigation -->
  <nav class="hidden lg:flex max-w-max w-full flex-1 items-center justify-center px-4 py-4 gap-4 flex-row" aria-label="Main">
    <a href={withBase('/')} class={navItemClass}>Home</a>

    {sections.map((section) => (
      <div
        class="relative"
        x-data="{open: false}"
        @keydown.escape="open = false"
        @click.outside="open = false"
      >
        <div class="flex flex-row items-center gap-0.5">
          <button
            type="button"
            x-ref="button"
            class:list={[navItemClass, "whitespace-nowrap"]}
            :aria-expanded="open"
            @click="open = !open"
          >
            {section.label}
          </button>
          <svg class="size-5 transition-transform" :class="open && 'rotate-180'" xmlns="http://www.w3.org/2000/svg"  fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 15.75 7.5-7.5 7.5 7.5" />
          </svg>
        </div>
        <template x-if="true">
          <ul
            x-show="open"
            x-transition
            class="absolute top-full mt-2 w-80 max-w-[calc(100vw-2rem)] bg-popover border border-border shadow-lg p-2 z-50 bg-background"
            x-anchor.bottom-start="$refs.button"
          >
            {section.items.map((item) => (
              <li>
                <a href={withBase(item.href)} class="group block px-3 py-2 hover:bg-primary hover:text-accent-foreground transition-all duration-300">
                  <div class="text-base font-medium">{item.title}</div>
                  <p class="text-base text-muted-foreground group-hover:text-accent-foreground font-sans">{item.desc}</p>
                </a>
              </li>
            ))}
          </ul>
        </template>
      </div>
    ))}
    <a href={withBase('/blog')} class={navItemClass}>Blog</a>
  </nav>

  <!-- Hamburger toggle: shown when the full nav doesn't fit -->
    <button
      type="button"
      class="lg:hidden ml-auto p-2 shrink-0"
      :aria-expanded="mobileOpen"
      aria-label="Toggle navigation menu"
      @click="mobileOpen = !mobileOpen"
    >
      <svg class="size-8" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
        <path x-show="!mobileOpen" stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5" />
        <path x-show="mobileOpen" x-cloak stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
      </svg>
    </button>

  <!-- Mobile Navigation -->
  <nav
    x-show="mobileOpen"
    x-cloak
    x-transition
    class="lg:hidden w-full flex flex-col gap-2 px-2 py-4"
    aria-label="Main"
  >
    <a href={withBase('/')} class={`${navItemClass} block border-b border-border last:border-b-0 py-2`} @click="mobileOpen = false">Home</a>

    {sections.map((section) => (
      <div x-data="{open: false}" class="border-b border-border last:border-b-0">
        <button
          type="button"
          class="flex w-full items-center justify-between py-2 text-2xl group"
          :aria-expanded="open"
          @click="open = !open"
        >
          <span class:list={[navItemClass, "group-hover:decoration-primary group-hover:text-primary"]}>{section.label}</span>
          <svg class="size-5 shrink-0 transition-transform" :class="open || 'rotate-180'" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 15.75 7.5-7.5 7.5 7.5" />
          </svg>
        </button>
        <ul x-show="open" x-transition class="mb-2 pl-2 border border-border shadow-lg p-2  bg-background">
          {section.items.map((item) => (
            <li>
              <a
                href={withBase(item.href)}
                class="group block px-3 py-2 hover:bg-primary hover:text-accent-foreground transition-all duration-300"
                @click="mobileOpen = false"
              >
                <div class="text-base font-medium">{item.title}</div>
                <p class="text-base text-muted-foreground group-hover:text-accent-foreground font-sans">{item.desc}</p>
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}

    <a href={withBase('/blog')} class={`${navItemClass} block`} @click="mobileOpen = false">Blog</a>

    <div class="flex flex-row gap-4 pt-2 md:hidden" id="socials-mobile">
      {social_links.map((social) => (
        <a 
          href={social.link}
          class="flex items-center justify-center bg-foreground size-8"
          style={
            `mask-image: url('${social.social}');
            mask-size: contain;
            mask-repeat: no-repeat;
            mask-position: center;`
          }></a>
      ))}
    </div>
  </nav>
</div>