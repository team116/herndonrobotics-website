---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import Portfolio from "../components/Portfolio.astro";
import TeamCard from "../components/TeamCard.astro";
import { Image } from "astro:assets";

import placeholder_img from "../../public/logo.png";

const portfolio = await getCollection("portfolio");

const sponsors = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/sponsors/*.{png,JPG,jpg,jpeg,webp,svg}",
  { eager: true },
);
---

<Layout title="Who Are We?">
  <div class="p-8 gap-12 flex flex-col">
    <section id="WhoAreWe">
      <div class="flex flex-col flex-1 justify-center max-w-[100rem] mx-auto">
        <h2 class="text-6xl font-audiowide mb-4 text-primary-foreground">
          <i>Who Are We?</i>
        </h2>

        <div class="text-2xl text-foreground">
          <p>Herndon Robotics, composed of FTC team 519 and FRC team 116 are the robotics programs for Herndon High School. The team was established in 1995 by Dave Lavery, a Program Executive for Solar System Exploration at NASA Headquarters. Herndon Robotics participates FIRST Robotics Competition (FRC) and FIRST Tech Challenge (FTC) competitions. These competitions are aimed at getting young people excited about engineering and technology.
<br />
<br />
Epsilon Delta is the robotics program for Herndon High School. We are a veteran team with a 30-year history of innovation and achievement. The team’s goals reach far beyond building a competitive robot. Herndon Robotics works year-round to reach out into the community, spreading the FIRST message and showing people the importance of STEM and STEM Education.
<br />
<br />
&ldquo;From Small Changes Come Big Differences.&rdquo; &ndash; &epsilon;∆</p>
        </div>
      </div>
    </section>

    <hr />

    <section id="portfolio">
      <div class="flex flex-col flex-1 justify-center">
        <div class="flex flex-row flex-1 justify-between items-center">
          <h2 class="text-6xl font-audiowide mb-4 text-primary-foreground">
            <i>Portfolio</i>
          </h2>
          {
            portfolio.length > 4 && (
              <a href="/portfolio" class="text-xl">
                see more →
              </a>
            )
          }
        </div>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
          {
            portfolio
              .sort((a, b) => {
                if (a.data.year > b.data.year) {
                  return 1;
                } else if (a.data.year < b.data.year) {
                  return -1;
                } else if (
                  a.data.competition_type == "FRC" &&
                  b.data.competition_type == "FTC"
                ) {
                  return 1;
                } else if (
                  a.data.competition_type == "FTC" &&
                  b.data.competition_type == "FRC"
                ) {
                  return -1;
                } else {
                  return 0;
                }
              })
              .slice(-4)
              .reverse()
              .map((item) => <Portfolio entry={item} />)
          }
        </div>
      </div>
    </section>

    <hr />

    <section id="team-members">
      <div class="flex flex-col flex-1 justify-center">
        <h2 class="text-6xl font-audiowide mb-4 text-primary-foreground">
          <i>Team Members</i>
        </h2>
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
          <TeamCard
            href="/team-members/mentors"
            image={placeholder_img}
            imageAlt="Mentor"
            title="Mentors"
            description="Lorem ipsum dolor sit amet, consectetur adipiscing elit. Curabitur non viverra dui. Pellentesque dapibus magna massa, id convallis felis bibendum at."
          />

          <TeamCard
            href="/team-members/students"
            image={placeholder_img}
            imageAlt="Student"
            title="Students"
            description="Lorem ipsum dolor sit amet, consectetur adipiscing elit. Curabitur non viverra dui. Pellentesque dapibus magna massa, id convallis felis bibendum at."
          />
        </div>
      </div>
    </section>

    <hr />

    <section id="sponsors">
      <div class="flex flex-col flex-1 justify-center">
        <h2 class="text-6xl font-audiowide mb-4 text-primary-foreground">
          <i>Sponsors</i>
        </h2>
        <div
          class="columns-2 sm:columns-3 md:columns-4 gap-4 [column-fill:balance] transform-[scaleY(-1)]"
        >
          {
            Object.values(sponsors).map((image) => (
              <Image
                src={image.default}
                alt="sponsor"
                class="w-full mb-4 break-inside-avoid transform-[scaleY(-1)] rounded-2xl"
              />
            ))
          }
        </div>
      </div>
    </section>
  </div>
</Layout>
